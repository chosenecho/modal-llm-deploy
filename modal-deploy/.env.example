# Copy to .env.local (gitignored) for local deploy-time overrides & smoke testing.
# Never commit real API keys or private model checkpoint identifiers.

# Bearer API key used for local smoke_test.py (must match Modal Secret `qwen-api-key`)
SGLANG_API_KEY=sk-replace-with-your-strong-secret

# Modal Proxy Auth Token (Settings -> Proxy Auth Tokens in Modal Dashboard)
# Checked at Modal's edge proxy BEFORE waking up the GPU container.
# MODAL_PROXY_KEY=wk-replace-with-your-proxy-key
# MODAL_PROXY_SECRET=ws-replace-with-your-proxy-secret

# Optional: disable edge proxy auth (not recommended; unauthenticated requests will wake the GPU)
# SGLANG_REQUIRE_PROXY_AUTH=true

# Optional: customize/randomize the endpoint subdomain (<workspace>--<label>.modal.run)
# SGLANG_ENDPOINT_LABEL=

# Optional: override the model directory inside the Modal Volume and served model ID
SGLANG_MODEL_SUBDIR=qwen38-27b-fp8
SGLANG_SERVED_MODEL_NAME=qwen3.8-27b-ft
